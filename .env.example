# Copy this file to `.env` (same folder) and fill in your key(s).
# `.env` is git-ignored so keys never get committed.

# A real Gemini API key from https://aistudio.google.com/apikey
# IMPORTANT: it must look like "AIzaSy..." (a permanent API key).
# A token starting with "AQ." or "ya29." is a short-lived OAuth access token
# (expires in ~1 hour) and will fail with 401 UNAUTHENTICATED — do NOT use it.
GEMINI_API_KEY=AIzaSy_your_real_api_key_here

# Optional: several keys to rotate through (comma-separated). The daily free
# quota is per key (project) and per model, so multiple keys from DIFFERENT
# Google Cloud projects/accounts multiply the free budget. 10-20 keys is plenty
# to build a whole country in one day on the free tier.
# GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3

# Optional: model fallback chain (comma-separated). Quota is per model too, so a
# chain lets one key keep going after a model's daily cap.
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Optional tuning (defaults shown)
# GEMINI_CONCURRENCY=4
# GEMINI_MAX_RETRIES=4
# GEMINI_TIMEOUT=60
